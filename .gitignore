# SECRETS — never commit. DEPLOYER_MNEMONIC is an Algorand mnemonic, i.e. a private key
# that controls its account outright; a committed .env would publish it irrevocably in git
# history. .env.example is the template and is intentionally NOT ignored.
.env
.env.*
!.env.example

# transient run logs / local state
last_run.log
*.log

# python
__pycache__/
*.pyc
.venv/
.venv-contracts/
# Any .venv-* an operator creates: the existing rules named two specific ones by hand,
# so a third (.venv-compile) was staged in full by `git add -A` -- thousands of files
# into a public MIT repo. Match the family, not the instances.
.venv-*/
venv/
.pytest_cache/

# Build artifacts are NEVER committed. A checked-in wheel/sdist silently goes stale against the
# source next to it while keeping the same version number, so `pip install sdk/dist/*.whl` and
# `pip install trelyan-pq` can be different code under one version string. Releases are built and
# signed in CI (.github/workflows/release.yml), which is the only provenance-bearing path.
dist/
build/
*.egg-info/

# native Falcon shared library (build locally per falcon_det1024.py header)
*.so
*.dylib
*.dll

# compiled contract artifacts are regeneratable; keep out/ if you want reviewers to skip compiling,
# otherwise uncomment to exclude:
# contracts/out/

# OS
.DS_Store

# local contract-test virtualenv (algokit-utils + pytest); never committed
.venv-contracts/

# scratch out-dir used by contracts/verify_teal_matches_source.py; never committed
contracts/.teal-check-*/
# Rust workspace build output (rust/)
rust/target/

# falcon-ct CI runs write here; CI publishes them to the job summary, the repo keeps only named sessions
evidence/ct/ci-run/
evidence/ct/out/

# scripts/verify_all.sh unpacks the pinned Falcon tarball and builds it in the repo root.
# README tells reviewers to run that script, so these must not show up as untracked noise.
falcon-src/
codec.lib
libfalcondet1024.pdb
